{
  "name": "arenasports",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first, integrity-focused community esports tournaments.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:workspace": "pnpm --filter @arenasports/contracts build && pnpm --filter @arenasports/database db:generate",
    "dev": "pnpm prepare:workspace && pnpm --parallel --filter @arenasports/api --filter @arenasports/mobile dev",
    "dev:api": "pnpm prepare:workspace && pnpm --filter @arenasports/api dev",
    "dev:mobile": "pnpm --filter @arenasports/mobile dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm prepare:workspace && pnpm -r --if-present typecheck",
    "test": "pnpm prepare:workspace && pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @arenasports/database db:generate",
    "db:migrate": "pnpm --filter @arenasports/database db:migrate",
    "db:studio": "pnpm --filter @arenasports/database db:studio"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^7.0.2"
  }
}
