# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
ENABLE_DEMO_AUTH=false

# PostgreSQL
DATABASE_URL=postgresql://arenasports:arenasports@localhost:5432/arenasports?schema=public

# Redis / async work
REDIS_URL=redis://localhost:6379

# Supabase Auth - use only the public/publishable key here, never a secret or service-role key
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AUTH_REQUEST_TIMEOUT_MS=5000

# Evidence storage placeholders - private bucket only
EVIDENCE_BUCKET=
EVIDENCE_REGION=
EVIDENCE_ENDPOINT=
EVIDENCE_ACCESS_KEY_ID=
EVIDENCE_SECRET_ACCESS_KEY=

# Mobile public configuration (never place server secrets in EXPO_PUBLIC_* values)
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
